# ===================================================================
# RentWheels Spring Boot - Local Environment Variables (.env.example)
# ===================================================================
# Copy these values into your environment or IDE run configuration.
# Never commit real credentials to GitHub.

# Direct Connection (default port 5432)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.hhknvyvetypclkqsdfkr.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# OR Supabase Session Pooler (port 6543 / 5432 - dual stack IPv4/IPv6)
# If your network does not support IPv6, use the Session Pooler:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.hhknvyvetypclkqsdfkr
# SPRING_DATASOURCE_PASSWORD=your_database_password_here

