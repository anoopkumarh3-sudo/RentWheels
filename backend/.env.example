# ===================================================================
# RentWheels Backend Environment Variables Template (.env.example)
# ===================================================================
# Copy these variables into your local environment or run configurations.
# Never commit real passwords to Git or GitHub.

# 1. Supabase PostgreSQL JDBC Connection Settings
# Where to find these in Supabase Dashboard:
# -> Project Settings -> Database -> Connection string -> JDBC
# Format: jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.hhknvyvetypclkqsdfkr.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_database_password_here

# 2. Razorpay Test Mode Credentials (Optional / Phase 8)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

